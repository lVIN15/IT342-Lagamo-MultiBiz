PAYMONGO_SECRET_KEY=your_paymongo_secret_key_here
PAYMONGO_PUBLIC_KEY=your_paymongo_public_key_here
PAYMONGO_WEBHOOK_SECRET=your_paymongo_webhook_secret_here

# Database (Supabase)
DB_URL=jdbc:postgresql://<host>:<port>/postgres?prepareThreshold=0
DB_USERNAME=your_database_username_here
DB_PASSWORD=your_database_password_here

# Security
JWT_SECRET=your_long_secure_random_jwt_secret_here

# Mail / SMTP
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
